---
const pageTitle = 'Ezra Rawitsch — Writer & Geographer'
const pageDescription = 'Writer and geographer. Maps, cities, and the politics of place.'
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap" rel="stylesheet">
</head>

<body>
  <!-- Terrain Background -->
  <div class="terrain-bg" aria-hidden="true"></div>
  
  <!-- Navigation -->
  <nav class="nav">
    <div class="nav-content">
      <a href="#about" class="nav-link">About</a>
      <a href="#book" class="nav-link">Book</a>
      <a href="#work" class="nav-link">Work</a>
      <a href="#writing" class="nav-link">Writing</a>
      <a href="#contact" class="nav-link">Contact</a>
    </div>
  </nav>

  <main class="container">
    <!-- Hero Section -->
    <section class="hero" id="hero">
      <a href="https://www.openstreetmap.org/#map=15/51.4700/-0.1183" class="coordinates" target="_blank" rel="noopener noreferrer">51°28'12"N 0°07'06"W</a>
      <h1 class="hero-title">Ezra Rawitsch</h1>
      <p class="hero-subtitle">Writer and geographer. Maps, cities, and the politics of place.</p>
    </section>

    <!-- About Section -->
    <section class="section" id="about">
      <div class="section-header">
        <h2 class="section-title">About</h2>
        <div class="section-coordinates" aria-hidden="true">01</div>
      </div>
      
      <div class="section-content">
        <p>I make maps, write about cities, and study how places work. I'm interested in housing, borders, and what it means to belong somewhere.</p>
        
        <p>I work at <a href="https://thebusinessofcities.com" target="_blank" rel="noopener noreferrer">The Business of Cities</a>, a cities research and strategy firm, where I build urban benchmarking analysis and data visualizations for cities and their champions.</p>
        
        <p>I studied on a Morehead-Cain scholarship at UNC Chapel Hill, and at KU Leuven and Vrije Universiteit Brussel in Belgium. I've lived in five cities in three countries but: <a href="https://www.youtube.com/watch?v=KcADqxnQA_4&list=RDKcADqxnQA_4&start_radio=1" target="_blank" rel="noopener noreferrer">I Love L.A.</a> My first book comes out in November.</p>
      </div>
    </section>

    <!-- Book Section -->
    <section class="section" id="book">
      <div class="section-header">
        <h2 class="section-title">Book</h2>
        <div class="section-coordinates" aria-hidden="true">02</div>
      </div>
      
      <div class="section-content">
        <div class="book-info">
          <h3 class="book-title">Visions of the Southland: A Year in Los Angeles County</h3>
          <p class="book-publisher">University of Chicago Press</p>
          <p class="book-credit">Edited by Wade Graham &amp; William Deverell · Maps by Ezra Rawitsch</p>
          
          <p>Twenty-four essays on Los Angeles County, one for each month, by writers including Gustavo Arellano, Keri Blakinger, Lynell George, Catherine Gudis, Christopher Hawthorne, Carolina A. Miranda, Laura J. Nelson, Susan Straight, and David L. Ulin. The book traces the county's metabolism across a full year: its water, air, music, prisons, borders, transit, art, and economy. I researched and designed 30 maps in dialogue with authors, to bring a spatial dimension to the text.</p>
          
          <div class="book-status">
            <span class="status-indicator"></span>
            <span class="status-text">November 2026</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Work Section -->
    <section class="section" id="work">
      <div class="section-header">
        <h2 class="section-title">Work</h2>
        <div class="section-coordinates" aria-hidden="true">03</div>
      </div>
      
      <div class="section-content">
        <div class="work-grid">
          <div class="work-item">
            <h3 class="work-title">Perth's Prospects</h3>
            <p class="work-description">The first purpose-built global benchmarking of Greater Perth, commissioned by Infrastructure WA. Situates Perth and Peel Region against peer cities worldwide to inform long-term infrastructure and growth strategy.</p>
            <div class="work-type">Infrastructure WA · 2025</div>
          </div>
          
          <a href="https://committeeforbrisbane.org.au/wp-content/uploads/2025/03/Benchmarking-SEQ-Web-1.pdf" class="work-item" target="_blank" rel="noopener noreferrer">
            <h3 class="work-title">Benchmarking South East Queensland</h3>
            <p class="work-description">Global benchmarking of SEQ ahead of the Brisbane 2032 Games, comparing the region across productivity, transport, liveability, and innovation against peer metro regions worldwide.</p>
            <div class="work-type">Council of Mayors SEQ · 2024–2025</div>
          </a>
          
          <a href="https://thebusinessofcities.com/work/" class="work-item" target="_blank" rel="noopener noreferrer">
            <h3 class="work-title">More projects at The Business of Cities</h3>
            <p class="work-description">Benchmarking, strategy, and research for cities, investment agencies, and development banks worldwide. See the full portfolio.</p>
            <div class="work-type">thebusinessofcities.com/work →</div>
          </a>
          
          <a href="https://thebusinessofcities.com" class="work-item" target="_blank" rel="noopener noreferrer">
            <h3 class="work-title">About The Business of Cities</h3>
            <p class="work-description">City intelligence for global business. We help cities find the right business, and business find the right cities.</p>
            <div class="work-type">thebusinessofcities.com →</div>
          </a>
          
          <a href="https://ezrawitsch.github.io/wikipedia_list_v2.html" class="work-item" target="_blank" rel="noopener noreferrer">
            <h3 class="work-title">Wikipedia Map</h3>
            <p class="work-description">An interactive map of Wikipedia articles by location. Search, browse, and read the encyclopedia geographically.</p>
            <div class="work-type">Side project · ezrawitsch.github.io →</div>
          </a>
          
          <a href="https://www.euki.de/wp-content/uploads/2024/07/SUNRISE-Project-Financing-for-Prosumer-Renewable-Energy-in-Lithuania-North-Macedonia-and-Bulgaria-November-2023-1.pdf" class="work-item" target="_blank" rel="noopener noreferrer">
            <h3 class="work-title">Financing Prosumer Renewable Energy in Lithuania, North Macedonia, and Bulgaria</h3>
            <p class="work-description">Policy paper on enabling citizen-led renewable energy across three European states.</p>
            <div class="work-type">EUKI · German Federal Ministry for Economic Affairs and Climate Action · 2023</div>
          </a>
          
          <a href="https://carolinacartography.org" class="work-item" target="_blank" rel="noopener noreferrer">
            <h3 class="work-title">Carolina Cartography</h3>
            <p class="work-description">Mapping, narrative, and human geography. New perspectives on spaces, places, and geographic difference.</p>
            <div class="work-type">carolinacartography.org →</div>
          </a>
        </div>
      </div>
    </section>

    <!-- Writing Section -->
    <section class="section" id="writing">
      <div class="section-header">
        <h2 class="section-title">Writing</h2>
        <div class="section-coordinates" aria-hidden="true">04</div>
      </div>
      
      <div class="section-content">
        <div class="writing-list">
          <a href="https://kuleuven.limo.libis.be/discovery/fulldisplay?docid=alma9994890984001488&context=L&vid=32KUL_KUL:KULeuven&search_scope=All_Content&tab=all_content_tab&lang=en" class="writing-item" target="_blank" rel="noopener noreferrer">
            <div class="writing-type">Academic · 2024</div>
            <h3 class="writing-title">Coalition Cartography: Mapping Urban Governance and Transportation in 20th-Century California</h3>
            <p class="writing-venue">KU Leuven · LAGT Award for the Best Thesis in Geography</p>
          </a>
          
          <a href="https://www.ceeol.com/search/article-detail?id=903160" class="writing-item" target="_blank" rel="noopener noreferrer">
            <div class="writing-type">Academic · 2020</div>
            <h3 class="writing-title">Seeing Sapa: Reading a Transnational Marketplace in the Post-Socialist Cityscape</h3>
            <p class="writing-venue">Lidé města · Urban People · Charles University</p>
          </a>
          
          <div class="writing-item writing-item--audio">
            <div class="writing-type">Audio Essay</div>
            <h3 class="writing-title">In the Musicality of the Moment</h3>
            <p class="writing-venue"><a href="https://soundcloud.com/ezrawitsch" target="_blank" rel="noopener noreferrer">SoundCloud</a></p>
            <div class="soundcloud-embed">
              <iframe width="100%" height="166" scrolling="no" frameborder="no" allow="autoplay" src="https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/ezrawitsch/in-the-musicality-of-the-moment&color=%23458585&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false"></iframe>
            </div>
          </div>
          
          <a href="https://carolinaangles.com/2018/10/18/reflections-on-a-prague-bazaar/" class="writing-item" target="_blank" rel="noopener noreferrer">
            <div class="writing-type">Essay · 2018</div>
            <h3 class="writing-title">Reflections on a Prague Bazaar</h3>
            <p class="writing-venue">Carolina Angles</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="section" id="contact">
      <div class="section-header">
        <h2 class="section-title">Contact</h2>
        <div class="section-coordinates" aria-hidden="true">05</div>
      </div>
      
      <div class="section-content">
        <div class="contact-grid">
          <div class="contact-item">
            <h3 class="contact-method">Email</h3>
            <a href="mailto:ezrawitsch@gmail.com" class="contact-link">ezrawitsch@gmail.com</a>
          </div>
          
          <div class="contact-item">
            <h3 class="contact-method">LinkedIn</h3>
            <a href="https://linkedin.com/in/ezrawitsch" class="contact-link" target="_blank" rel="noopener noreferrer">@ezrawitsch</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-content">
      <div class="footer-coordinates" aria-hidden="true">© 2026</div>
      <p class="footer-text">Ezra Rawitsch</p>
    </div>
  </footer>
</body>

<style>
  :root {
    --cream: #faf8f3;
    --cream-light: #fefcf9;
    --ink: #2c2c2c;
    --slate: #6b7280;
    --teal: #458585;
    --teal-light: #5a9999;
    --grid-color: #f0ede6;
    --accent-line: #e5e1d8;
    
    --font-serif: 'Source Serif 4', Georgia, serif;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2rem;
    --space-xl: 3rem;
    --space-2xl: 4rem;
    --space-3xl: 4rem;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-sans);
    background-color: var(--cream);
    color: var(--ink);
    line-height: 1.6;
    font-size: 16px;
    position: relative;
    overflow-x: hidden;
  }

  /* Terrain Background */
  .terrain-bg {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('/terrain.jpg');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    background-attachment: scroll;
    pointer-events: none;
    z-index: -1;
    animation: terrain-scroll linear forwards;
    animation-timeline: scroll(root);
  }

  @keyframes terrain-scroll {
    from { background-position: center top; }
    to { background-position: center bottom; }
  }

  /* Navigation */
  .nav {
    position: fixed;
    top: var(--space-sm);
    right: var(--space-lg);
    z-index: 100;
    background: rgba(250, 248, 243, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid var(--accent-line);
    border-radius: 2px;
    padding: var(--space-xs);
  }

  .nav-content {
    display: flex;
    gap: var(--space-sm);
  }

  .nav-link {
    color: var(--slate);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 400;
    padding: var(--space-xs) var(--space-sm);
    border-radius: 2px;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--teal);
    background-color: var(--cream-light);
  }

  /* Layout */
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-lg) var(--space-2xl);
  }

  /* Hero Section */
  .hero {
    padding: var(--space-lg) 0 var(--space-sm);
    position: relative;
  }

  .coordinates {
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    color: var(--slate);
    margin-bottom: var(--space-sm);
    letter-spacing: 0.1em;
    text-decoration: none;
    display: inline-block;
    transition: color 0.2s ease;
  }

  a.coordinates:hover {
    color: var(--teal);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: var(--space-sm);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--slate);
    max-width: 500px;
    font-weight: 400;
    line-height: 1.5;
  }

  /* Sections */
  .section {
    margin: var(--space-2xl) 0;
    position: relative;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--accent-line);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .section-coordinates {
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    color: var(--slate);
    letter-spacing: 0.1em;
  }

  .section-content {
    max-width: 700px;
  }

  .section-content a {
    color: var(--teal);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .section-content a:hover {
    border-bottom-color: var(--teal);
  }

  .section-intro {
    font-size: 1.05rem;
    color: var(--slate);
    margin-bottom: var(--space-lg);
  }

  .section-intro a {
    color: var(--teal);
  }

  p {
    margin-bottom: var(--space-md);
    color: var(--slate);
    line-height: 1.7;
  }

  p:last-child {
    margin-bottom: 0;
  }

  /* Book Section */
  .book-info {
    background: var(--cream-light);
    padding: var(--space-xl);
    border: 1px solid var(--accent-line);
    position: relative;
  }

  .book-info::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--teal);
  }

  .book-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--ink);
    margin-bottom: var(--space-xs);
    font-weight: 500;
    font-style: italic;
  }

  .book-publisher {
    color: var(--teal);
    font-weight: 500;
    margin-bottom: var(--space-xs);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .book-credit {
    font-size: 0.9rem;
    color: var(--slate);
    margin-bottom: var(--space-lg) !important;
  }

  .book-status {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
  }

  .status-text {
    font-size: 0.9rem;
    color: var(--teal);
    font-weight: 500;
  }

  /* Work Section */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .work-item,
  a.work-item {
    display: block;
    background: var(--cream-light);
    padding: var(--space-lg);
    border: 1px solid var(--accent-line);
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
    color: inherit;
  }

  a.work-item:hover {
    transform: translateY(-2px);
    border-color: var(--teal);
    border-bottom-color: var(--teal);
  }

  .work-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, var(--teal), transparent);
  }

  .work-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--ink);
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .work-description {
    font-size: 0.95rem;
    margin-bottom: var(--space-md);
  }

  .work-type {
    font-size: 0.8rem;
    color: var(--teal);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Writing Section */
  .writing-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .writing-item,
  a.writing-item {
    display: block;
    background: var(--cream-light);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--accent-line);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  a.writing-item:hover {
    border-color: var(--teal);
    border-bottom-color: var(--teal);
  }

  .writing-type {
    font-size: 0.75rem;
    color: var(--teal);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }

  .writing-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--ink);
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .writing-venue {
    font-size: 0.9rem;
    color: var(--slate);
    margin-bottom: 0;
  }

  /* SoundCloud Embed */
  .soundcloud-embed {
    margin-top: var(--space-sm);
  }

  .writing-item--audio {
    padding-bottom: var(--space-md);
  }

  /* Contact Section */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-lg);
  }

  .contact-item {
    background: var(--cream-light);
    padding: var(--space-lg);
    border: 1px solid var(--accent-line);
  }

  .contact-method {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--ink);
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .contact-link {
    color: var(--teal);
    text-decoration: none;
    font-weight: 500;
    font-size: 1.05rem;
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: var(--teal-light);
  }

  /* Footer */
  .footer {
    margin-top: var(--space-3xl);
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--accent-line);
  }

  .footer-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-coordinates {
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    color: var(--slate);
    letter-spacing: 0.1em;
  }

  .footer-text {
    color: var(--slate);
    font-size: 0.9rem;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .container {
      padding: var(--space-lg) var(--space-sm);
    }

    .nav {
      position: static;
      margin-bottom: var(--space-lg);
      background: var(--cream-light);
      border-radius: 0;
    }

    .nav-content {
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero {
      padding: var(--space-lg) 0;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .section-title {
      font-size: 1.8rem;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }

    .work-grid {
      grid-template-columns: 1fr;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }

    .footer-content {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: clamp(1.8rem, 8vw, 2.5rem);
    }

    .section-title {
      font-size: 1.5rem;
    }

    .work-title,
    .writing-title,
    .book-title {
      font-size: 1rem;
    }

    .work-grid {
      gap: var(--space-sm);
    }

    .nav-link {
      font-size: 0.8rem;
      padding: var(--space-xs) 0.4rem;
    }
  }
</style>
</html>
