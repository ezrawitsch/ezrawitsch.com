<body>
  <div class="terrain-bg" aria-hidden="true"></div>

  <main class="page">
    <header class="masthead">
      <h1>Ezra Rawitsch</h1>
      <p class="lede">I make maps and digital tools to see places from a new perspective, and I write about the intersection of geography, politics, and technology.</p>
      <nav class="nav">
        <a href="#about">About</a>
        <a href="#book">Book</a>
